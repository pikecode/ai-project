# 手动或 Compose 部署配置；本地管理器的 .env.local 优先级最高。
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:4b
CONTEXT_TOKENS=16384
OUTPUT_TOKENS=1024
VISION_MODEL=llava
DATABASE_URL=sqlite:///./agent.db
WORKSPACE_DIR=./uploads
RAG_DATA_DIR=./data
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
HOST=127.0.0.1
PORT=8653
AGENT_API_URL=http://127.0.0.1:8000
# 本地管理器在 .env.local 生成独立令牌；Compose 必须设置。
API_TOKEN=
WEB_USERNAME=admin
# 非回环监听必须设置；共享访问时放在 HTTPS 反向代理后。
WEB_PASSWORD=
# 仅允许明确授权的公网 HTTPS 域名，空值表示禁用通用 HTTP 工具。
HTTP_ALLOWED_HOSTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Compose PostgreSQL 配置，使用时填写强密码。
POSTGRES_PASSWORD=
